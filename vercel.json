{
  "crons": [
    { "path": "/api/cron-avisos", "schedule": "0 15 * * *" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "enkaje-pccm.vercel.app" }],
      "destination": "https://enkajepro.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/taller/(.*)", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/legal/(.*)", "destination": "/index.html" },
    { "source": "/portal", "destination": "/index.html" },
    { "source": "/((?!api|assets|favicon).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
